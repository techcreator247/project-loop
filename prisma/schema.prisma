generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id        String     @id @default(cuid())
  name      String
  createdAt DateTime   @default(now())
  feedback  Feedback[]
  users     User[]
}

model User {
  id             String       @id @default(cuid())
  name           String
  email          String       @unique
  organizationId String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model Feedback {
  id             String       @id @default(cuid())
  message        String
  source         String
  sentiment      Sentiment    @default(NEUTRAL)
  category       String?
  customerName   String?
  createdAt      DateTime     @default(now())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}
